{
  "name": "chatgpt",
  "publisher": "openai",
  "version": "26.51111.21308",
  "displayName": "Jimao",
  "description": "Jimao is a coding agent that works with you everywhere you code — included in ChatGPT Plus, Pro, Business, Edu, and Enterprise plans.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "codex",
    "openai",
    "chatgpt",
    "ai",
    "agent",
    "coding",
    "code",
    "chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "extensionPack": [
    "openai.codex-audio"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "languageModelProxy"
  ],
  "icon": "resources/jimao.png",
  "//": "Codex command contributions in contributes.commands/keybindings and canonical setting contributions in contributes.configuration are generated and checked in for extension dev; run the matching pnpm --dir extension ...:fix script after editing them.",
  "contributes": {
    "commands": [
      {
        "command": "chatgpt.implementTodo",
        "title": "Implement with Jimao",
        "category": "Jimao",
        "enablement": "false"
      },
      {
        "command": "chatgpt.openSidebar",
        "title": "Open Jimao Sidebar",
        "category": "Jimao",
        "icon": {
          "light": "resources/jimao.svg",
          "dark": "resources/jimao.svg"
        }
      },
      {
        "command": "chatgpt.openCommandMenu",
        "title": "Open Jimao Command Menu",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.newCodexPanel",
        "title": "New Jimao Agent",
        "category": "Jimao",
        "icon": "$(plus)"
      },
      {
        "command": "chatgpt.addToThread",
        "title": "Add to Jimao Chat",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.addFileToThread",
        "title": "Add File to Jimao Chat",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.newChat",
        "title": "New Chat in Jimao Sidebar",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.showLspMcpCliArgs",
        "title": "Copy Jimao CLI args for LSP MCP",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.dumpNuxState",
        "title": "Debug: print NUX state to console",
        "category": "Jimao",
        "enablement": "chatgpt.sidebarView.visible"
      },
      {
        "command": "chatgpt.resetNuxState",
        "title": "Debug: reset NUX state",
        "category": "Jimao",
        "enablement": "chatgpt.sidebarView.visible"
      },
      {
        "command": "chatgpt.startLanAccess",
        "title": "开启局域网访问",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.stopLanAccess",
        "title": "关闭局域网访问（全部窗口）",
        "category": "Jimao"
      },
      {
        "command": "chatgpt.copyLanAddress",
        "title": "复制局域网访问地址",
        "category": "Jimao"
      }
    ],
    "keybindings": [
      {
        "command": "chatgpt.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "chatgpt.supportsNewChatKeyShortcut"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Jimao Settings",
      "properties": {
        "chatgpt.commentCodeLensEnabled": {
          "description": "Enable CodeLens above TODO comments to implement with Jimao.",
          "type": "boolean",
          "default": true
        },
        "chatgpt.persistentProviderRetries": {
          "description": "Keep waiting for network and model-provider recovery in custom engine builds. Maximum retry wait is five minutes. Stop cancels the current turn. Reload the window after changing this setting.",
          "type": "boolean",
          "default": true,
          "scope": "application"
        },
        "chatgpt.cliExecutable": {
          "description": "DEVELOPMENT ONLY: Path to the Jimao CLI executable. You do NOT need to set this unless you are actively developing the Jimao CLI. If set this manually, parts of the extension may not work as expected.",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application",
          "restricted": true
        },
        "chatgpt.openOnStartup": {
          "description": "Focus the Jimao sidebar when the extension finishes starting up.",
          "type": "boolean",
          "default": false
        },
        "chatgpt.followUpQueueMode": {
          "description": "Control whether follow-up messages are queued or steer the current run. Press Cmd/Ctrl+Shift+Enter to do the opposite for a single in-progress follow-up.",
          "type": "string",
          "enum": [
            "queue",
            "steer",
            "interrupt"
          ],
          "default": "queue"
        },
        "chatgpt.composerEnterBehavior": {
          "description": "Enter behavior for the Jimao composer.",
          "type": "string",
          "enum": [
            "enter",
            "cmdIfMultiline",
            "cmdAlways"
          ],
          "default": "enter"
        },
        "chatgpt.reviewDelivery": {
          "description": "Start /review inline in the current chat when possible or launch a separate review chat",
          "type": "string",
          "enum": [
            "inline",
            "detached"
          ],
          "default": "inline"
        },
        "chatgpt.localeOverride": {
          "description": "Preferred language for the Jimao UI. Leave empty to auto detect.",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application"
        },
        "chatgpt.runCodexInWindowsSubsystemForLinux": {
          "description": "Deprecated. To run Jimao in WSL, reopen your folder using the Microsoft WSL extension. Turn this setting off to run Jimao on Windows. Changing it reloads the window.",
          "type": "boolean",
          "default": false
        },
        "chatgpt.lanPort": {
          "type": "number",
          "default": 8765,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Jimao 局域网共享入口端口。所有已接入窗口使用同一端口，停止全部窗口后可更改。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexViewContainer",
          "title": "Jimao",
          "icon": "resources/jimao.svg",
          "when": "chatgpt.doesNotSupportSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "codexSecondaryViewContainer",
          "title": "Jimao",
          "icon": "resources/jimao.svg",
          "when": "!chatgpt.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "codexViewContainer": [
        {
          "id": "chatgpt.sidebarView",
          "type": "webview",
          "name": "Jimao",
          "when": "chatgpt.doesNotSupportSecondarySidebar"
        }
      ],
      "codexSecondaryViewContainer": [
        {
          "id": "chatgpt.sidebarSecondaryView",
          "type": "webview",
          "name": "Jimao",
          "when": "!chatgpt.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "chatgpt.conversationEditor",
        "displayName": "Jimao Chat",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "openai-codex:/**/*"
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "chatgpt.openSidebar",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "chatgpt.addToThread",
          "group": "codex",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "chatgpt.addFileToThread",
          "group": "2_chat",
          "order": 2,
          "when": "resourceScheme == file"
        }
      ],
      "webview/context": [
        {
          "command": "chatgpt.newChat",
          "when": "(webviewId == 'chatgpt.sidebarView' || webviewId == 'chatgpt.sidebarSecondaryView') && chatgpt.supportsNewChatMenu"
        }
      ],
      "commandPalette": [
        {
          "command": "chatgpt.showLspMcpCliArgs",
          "when": "chatgpt.lspMcpEnabled"
        }
      ],
      "chatSessions/newSession": [
        {
          "command": "chatgpt.newCodexPanel",
          "when": "chatSessionType == openai-codex"
        }
      ]
    },
    "chatSessions": [
      {
        "type": "openai-codex",
        "name": "Jimao",
        "displayName": "OpenAI Jimao",
        "description": "OpenAI Jimao integration for VS Code"
      }
    ],
    "grammars": [
      {
        "language": "codex-rules",
        "scopeName": "source.codex-rules",
        "path": "./syntaxes/starlark.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "codex-rules",
        "aliases": [
          "Jimao Rules"
        ],
        "extensions": [
          ".rules"
        ],
        "configuration": "./syntaxes/starlark.configuration.json"
      }
    ]
  }
}
